# Backend Environment Variables Example
# Copy this file to create .env and fill in your actual values

# Server
PORT=8000
NODE_ENV=development

# MongoDB
# For local Docker: mongodb://admin:password123@mongodb:27017/eshop?authSource=admin
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/test?appName=Cluster0

# JWT & Security
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_EXPIRES=7d
ACTIVATION_SECRET=your_activation_secret_here

# Email (SMTP)
SMPT_HOST=smtp.gmail.com
SMPT_PORT=465
SMPT_PASSWORD=your_gmail_app_password_here
SMPT_MAIL=your_email@gmail.com

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_API_KEY=pk_test_your_stripe_public_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS
FRONTEND_URL=http://localhost:3001
